  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "archiver": "^7.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
